                    "name": "Change Password",
                    "request": {
                        "method": "POST",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"current_password\": \"actual_pass\", \"new_password\": \"new_pass\"}"
                        },
                        "url": "{{base_url}}/api/v1/auth/change-password"
                    }
                }
