        {
            "name": "🔐 Auth & Identity",
            "item": [
                {
                    "name": "JWT Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "username",
                                    "value": "admin@tatvic.com",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "admin",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{base_url}}/api/v1/auth/access-token"
                    }
                },
                {
                    "name": "Profile Details",
                    "request": {
                        "method": "GET",
                        "url": "{{base_url}}/api/v1/auth/me"
                    }
                },
                {
