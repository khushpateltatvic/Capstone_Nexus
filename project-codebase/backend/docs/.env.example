# --- Application ---
PROJECT_NAME="Project Nexus"
API_V1_STR="/api/v1"

# --- Database ---
# MongoDB connection string (Local or Atlas)
MONGO_CONNECTION_STRING="mongodb://localhost:27017"
DATABASE_NAME="project_nexus"

# --- Security ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your_super_secret_random_hex_string_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- AI / LLM ---
# Get your Groq API key from https://console.groq.com/
GROQ_API_KEY="gsk_your_key_here"
# Optional: Get your Gemini API key for embeddings
GOOGLE_API_KEY=""
LLM_MODEL="llama3-70b-8192"

# Embedding Config
EMBEDDING_PROVIDER="huggingface" # "huggingface" (local) or "gemini" (cloud)
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5" # Only used if provider is huggingface

# --- Google API (Optional for Gmail/Drive) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_POLL_LABEL="Project-Nexus-Intake"
DRIVE_WATCH_FOLDER_ID=""

# --- In-Memory Settings ---
WATCHDOG_POLL_INTERVAL=300 # 5 minutes
